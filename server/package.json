{
  "name": "@babyone/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json && cp -R src/prompts dist/prompts",
    "start": "node dist/index.js",
    "db:backup": "node dist/ops/databaseBackup.js backup",
    "db:verify-restore": "node dist/ops/databaseBackup.js verify-restore",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babyone/contracts": "0.1.0",
    "@anthropic-ai/sdk": "^0.30.1",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.5.0",
    "hono": "^4.6.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
